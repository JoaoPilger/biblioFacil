# Variáveis de ambiente para rodar a imagem Docker (joaopilger1/bibliofacil).
# Copie para .env e ajuste os valores, depois rode:
#   docker run -p 3000:3000 --env-file .env joaopilger1/bibliofacil:latest

# Porta em que o servidor escuta dentro do container
PORT=3000

# Segredo para assinatura de tokens JWT
JWT_SECRET=troque_por_uma_chave_segura

# Configurações do PostgreSQL (o banco precisa estar acessível a partir do container)
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=Bibliofacil
DB_USER=postgres
DB_PASSWORD=sua_senha_aqui

# Configurações de e-mail (SMTP) — deixe vazio para desabilitar envio
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu_usuario@exemplo.com
SMTP_PASS=sua_senha_smtp
SMTP_FROM="BiblioFácil <noreply@exemplo.com>"

# Dias antes do vencimento para alerta por e-mail
EMAIL_DIAS_ALERTA_VENCIMENTO=2
