# Porta do servidor Express
PORT=3000

# Segredo para assinatura de tokens JWT
JWT_SECRET=troque_por_uma_chave_segura

# URL do frontend (para CORS)
CLIENT_URL=http://localhost:5173

# Configurações do PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=Bibliofacil
DB_USER=postgres
DB_PASSWORD=sua_senha_aqui

# Configurações de e-mail (SMTP) — deixe vazio para desabilitar envio
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu_usuario@exemplo.com
SMTP_PASS=sua_senha_smtp
SMTP_FROM="BiblioFácil <noreply@exemplo.com>"

# Dias antes do vencimento para alerta por e-mail
EMAIL_DIAS_ALERTA_VENCIMENTO=2
